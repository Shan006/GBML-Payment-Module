{
  "moduleId": "circular-economy-credits-sme",
  "moduleName": "Circular Economy Credits System for SMEs",
  "moduleType": "CUSTOM_CIRCULAR_ECONOMY",
  "description": "Token + Bundle NFT + DAO governance stack for SME sustainability credits. All token/NFT transfers route through JVD/EGCR settlement rails with KYC/AML compliance hooks.",
  "contracts": [
    {
      "contractName": "CircularCreditsToken",
      "contractType": "TOKEN",
      "jrcStandard": "JRC-20",
      "routeThroughJvdEgcr": true,
      "constructorParams": [
        "Circular Economy Credits",
        "CEC",
        18,
        "1000000000000000000000000",
        "{{walletAddress}}",
        "{{routerAddress}}"
      ]
    },
    {
      "contractName": "CreditBundleNFT",
      "contractType": "BUNDLE",
      "jrcStandard": "JRC-998",
      "routeThroughJvdEgcr": true,
      "dependencies": ["CircularCreditsToken"],
      "constructorParams": [
        "Credit Bundle Collection",
        "CBNDL",
        "{{routerAddress}}"
      ]
    },
    {
      "contractName": "CreditsDAO",
      "contractType": "GOVERNANCE",
      "jrcStandard": "JRC-CUSTOM",
      "routeThroughJvdEgcr": false,
      "dependencies": ["CircularCreditsToken"],
      "abi": [
        {
          "inputs": [
            { "internalType": "address", "name": "token", "type": "address" },
            { "internalType": "address", "name": "admin", "type": "address" }
          ],
          "stateMutability": "nonpayable",
          "type": "constructor"
        },
        {
          "inputs": [
            { "internalType": "string", "name": "description", "type": "string" },
            { "internalType": "uint256", "name": "duration", "type": "uint256" }
          ],
          "name": "createProposal",
          "outputs": [{ "internalType": "uint256", "name": "", "type": "uint256" }],
          "stateMutability": "nonpayable",
          "type": "function"
        },
        {
          "inputs": [
            { "internalType": "uint256", "name": "proposalId", "type": "uint256" },
            { "internalType": "bool", "name": "support", "type": "bool" }
          ],
          "name": "vote",
          "outputs": [],
          "stateMutability": "nonpayable",
          "type": "function"
        }
      ],
      "bytecode": "0x608060405234801561001057600080fd5b50...",
      "constructorParams": [
        "{{treasuryAddress}}",
        "{{walletAddress}}"
      ]
    }
  ],
  "services": {
    "wallet": true,
    "settlement": true,
    "conversion": false
  },
  "compliance": {
    "kycRequired": true,
    "amlRequired": true
  },
  "switchable": {
    "enabled": true,
    "analytics": true,
    "transactions": true,
    "compliance": true,
    "governance": true
  },
  "uiProperties": {
    "icon": "🌍",
    "primaryColor": "#43e97b",
    "displayName": "Circular Economy Credits"
  },
  "platformIntegrations": ["GRANTS", "PAYMENTS", "CREDIT", "MARKETPLACE"],
  "enablementPayload": {
    "moduleId": "circular-economy-credits-sme",
    "moduleType": "CUSTOM_CIRCULAR_ECONOMY",
    "comment": "After registering via POST /gbml/custom-modules, enable with POST /gbml/enable-blockchain using only moduleId + moduleType (contractDefinitions resolved from registry)"
  }
}
